#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"
VERSION="$(cat VERSION 2>/dev/null || echo 1.0.0)"
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; BOLD='\033[1m'; NC='\033[0m'
log_info(){ printf "%b[INFO]%b %s\n" "$BLUE" "$NC" "$*"; }
log_warn(){ printf "%b[WARN]%b %s\n" "$YELLOW" "$NC" "$*"; }
log_error(){ printf "%b[ERROR]%b %s\n" "$RED" "$NC" "$*" >&2; }
die(){ log_error "$*"; exit 1; }
need_root(){ [[ ${EUID:-$(id -u)} -eq 0 ]] || die "Run with sudo/root."; }
compose(){ docker compose --env-file .env -f compose.yaml "$@"; }
ask(){ local prompt=$1 default=${2:-} ans; read -r -p "$prompt [$default]: " ans || true; echo "${ans:-$default}"; }
yesno(){ local prompt=$1 default=${2:-n} ans; read -r -p "$prompt [$default]: " ans || true; ans=${ans:-$default}; [[ $ans =~ ^[Yy] ]]; }
rand(){ openssl rand -hex "${1:-32}"; }
load_env(){ [[ -f .env ]] && set -a && # shellcheck disable=SC1091
  source .env && set +a; }
pm(){ command -v apt-get >/dev/null && echo apt && return; command -v dnf >/dev/null && echo dnf && return; command -v yum >/dev/null && echo yum && return; command -v pacman >/dev/null && echo pacman && return; command -v zypper >/dev/null && echo zypper && return; die "Unsupported package manager"; }
install_pkgs(){ local m; m=$(pm); log_info "Using package manager: $m"; case "$m" in apt) apt-get update; DEBIAN_FRONTEND=noninteractive apt-get install -y docker.io docker-compose-plugin curl wget git jq openssl tar zstd dnsutils certbot lsof net-tools gettext-base ca-certificates;; dnf) dnf install -y docker docker-compose-plugin curl wget git jq openssl tar zstd bind-utils certbot lsof net-tools gettext;; yum) yum install -y docker docker-compose-plugin curl wget git jq openssl tar zstd bind-utils certbot lsof net-tools gettext;; pacman) pacman -Sy --noconfirm docker docker-compose curl wget git jq openssl tar zstd bind-tools certbot lsof net-tools gettext;; zypper) zypper --non-interactive install docker docker-compose curl wget git jq openssl tar zstd bind-utils certbot lsof net-tools gettext-runtime;; esac; systemctl enable --now docker 2>/dev/null || service docker start 2>/dev/null || true; }
detect_public_ip(){ curl -fsS https://api.ipify.org 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}' || echo 127.0.0.1; }
detect_tz(){ cat /etc/timezone 2>/dev/null || timedatectl show -p Timezone --value 2>/dev/null || echo UTC; }
detect_email(){ getent aliases root 2>/dev/null | awk '{print $2}' | head -1 || echo "root@$(hostname -f 2>/dev/null || hostname)"; }
gen_env(){ [[ -f .env ]] && { log_info ".env already exists; keeping it."; return; }; local host ip tz email threads ram; host=$(hostname -f 2>/dev/null || hostname); ip=$(detect_public_ip); tz=$(detect_tz); email=$(detect_email); threads=$(nproc 2>/dev/null || echo 2); ram=$(awk '/MemTotal/{printf "%.0f", $2/1024/1024}' /proc/meminfo 2>/dev/null || echo 2); cat > .env <<EOFENV
COMPOSE_PROJECT_NAME=laziestmatrix
MATRIX_DOMAIN=${host}
MATRIX_SERVER_NAME=${host}
PUBLIC_IP=${ip}
TZ=${tz}
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=$(rand 24)
REDIS_PASSWORD=$(rand 24)
SYNAPSE_REGISTRATION_SHARED_SECRET=$(rand 32)
SYNAPSE_MACAROON_SECRET_KEY=$(rand 32)
SYNAPSE_FORM_SECRET=$(rand 32)
TURN_SHARED_SECRET=$(rand 32)
TURN_REALM=${host}
ENABLE_HTTPS=false
LE_EMAIL=${email}
SYNAPSE_WORKERS=${threads}
DETECTED_RAM_GB=${ram}
ELEMENT_DEFAULT_COUNTRY_CODE=US
EOFENV
chmod 600 .env; }
render(){ load_env; export PUBLIC_BASE_URL; if [[ ${ENABLE_HTTPS:-false} == true ]]; then PUBLIC_BASE_URL="https://${MATRIX_DOMAIN}"; envsubst < templates/nginx-https.conf.tpl > nginx/conf.d/matrix.conf; else PUBLIC_BASE_URL="http://${MATRIX_DOMAIN}"; envsubst < templates/nginx-http.conf.tpl > nginx/conf.d/matrix.conf; fi; envsubst < templates/homeserver.yaml.tpl > synapse/homeserver.yaml; envsubst < templates/turnserver.conf.tpl > coturn/turnserver.conf; envsubst < templates/element-config.json.tpl > element/config.json; }
init_synapse(){ load_env; [[ -f "synapse/${MATRIX_SERVER_NAME}.signing.key" ]] || compose run --rm synapse generate --server-name "$MATRIX_SERVER_NAME" --config-path /data/homeserver.yaml --report-stats=no >/dev/null; render; }
wait_health(){ local svc=$1 i; for i in {1..60}; do compose ps "$svc" | grep -q healthy && return 0; sleep 2; done; return 1; }
install(){ need_root; install_pkgs; gen_env; load_env; MATRIX_DOMAIN=$(ask "Domain" "$MATRIX_DOMAIN"); PUBLIC_IP=$(ask "Public IP" "$PUBLIC_IP"); TZ=$(ask "Timezone" "$TZ"); sed -i "s|^MATRIX_DOMAIN=.*|MATRIX_DOMAIN=$MATRIX_DOMAIN|;s|^MATRIX_SERVER_NAME=.*|MATRIX_SERVER_NAME=$MATRIX_DOMAIN|;s|^TURN_REALM=.*|TURN_REALM=$MATRIX_DOMAIN|;s|^PUBLIC_IP=.*|PUBLIC_IP=$PUBLIC_IP|;s|^TZ=.*|TZ=$TZ|" .env; mkdir -p postgres/data redis/data synapse/media_store synapse/uploads coturn nginx/conf.d element certs backups; render; log_info "Building images and starting database/redis"; compose build; compose up -d postgres redis; wait_health postgres || die "PostgreSQL did not become healthy"; wait_health redis || die "Redis did not become healthy"; init_synapse; compose up -d; if yesno "Enable HTTPS with Let's Encrypt?" n; then cert; fi; if yesno "Create administrator?" y; then users; fi; doctor || true; summary; }
summary(){ load_env; printf "\n%bLAZIESTMATRIX installed%b\nMatrix: %s://%s\nElement: %s://%s\nProject: %s\n" "$GREEN$BOLD" "$NC" "$([[ ${ENABLE_HTTPS:-false} == true ]] && echo https || echo http)" "$MATRIX_DOMAIN" "$([[ ${ENABLE_HTTPS:-false} == true ]] && echo https || echo http)" "$MATRIX_DOMAIN" "$ROOT_DIR"; }
cert(){ need_root; load_env; local d e; d=$(ask "Domain" "${MATRIX_DOMAIN:-$(hostname -f)}"); e=$(ask "Email" "${LE_EMAIL:-root@localhost}"); sed -i "s|^MATRIX_DOMAIN=.*|MATRIX_DOMAIN=$d|;s|^MATRIX_SERVER_NAME=.*|MATRIX_SERVER_NAME=$d|;s|^TURN_REALM=.*|TURN_REALM=$d|;s|^LE_EMAIL=.*|LE_EMAIL=$e|;s|^ENABLE_HTTPS=.*|ENABLE_HTTPS=true|" .env; compose up -d nginx; certbot certonly --webroot -w /var/lib/docker/volumes --config-dir "$ROOT_DIR/certs" --work-dir "$ROOT_DIR/certs/work" --logs-dir "$ROOT_DIR/certs/logs" -d "$d" -m "$e" --agree-tos --non-interactive || certbot certonly --standalone --config-dir "$ROOT_DIR/certs" --work-dir "$ROOT_DIR/certs/work" --logs-dir "$ROOT_DIR/certs/logs" -d "$d" -m "$e" --agree-tos --non-interactive; render; compose restart nginx coturn; }
users(){ load_env; local u p; u=$(ask "Admin username" admin); read -r -s -p "Admin password: " p; echo; compose exec synapse register_new_matrix_user -c /data/homeserver.yaml -u "$u" -p "$p" -a http://localhost:8008; }
doctor(){ load_env || true; printf "%-28s %-8s %s\n" Check Status Detail; check(){ if eval "$2" >/dev/null 2>&1; then printf "%-28s ${GREEN}OK${NC}       %s\n" "$1" "$3"; else printf "%-28s ${RED}FAIL${NC}     %s\n" "$1" "$3"; fi; }; check Docker "docker info" "daemon"; check Compose "docker compose version" "plugin"; check PostgreSQL "compose exec -T postgres pg_isready -U ${POSTGRES_USER:-synapse}" "database"; check Redis "compose exec -T redis redis-cli -a ${REDIS_PASSWORD:-x} ping" "cache"; check Matrix_API "curl -fsS http://localhost/_matrix/client/versions" "client API"; check Element "curl -fsS http://localhost" "web"; check Nginx "curl -fsS http://localhost/healthz" "proxy"; check Coturn_TCP "nc -z 127.0.0.1 3478" "turn tcp"; check DNS "getent hosts ${MATRIX_DOMAIN:-localhost}" "domain"; check Ports "lsof -i :80 -i :443 -i :8448 -i :3478" "listeners"; [[ -d certs/live/${MATRIX_DOMAIN:-} ]] && openssl x509 -checkend 2592000 -noout -in "certs/live/${MATRIX_DOMAIN}/fullchain.pem" && printf "%-28s ${GREEN}OK${NC}       cert expiry\n" HTTPS || printf "%-28s ${YELLOW}WARNING${NC}  no local cert\n" HTTPS; }
status(){ load_env || true; . /etc/os-release 2>/dev/null || true; echo "OS: ${PRETTY_NAME:-unknown}"; echo "Kernel: $(uname -r)"; docker --version 2>/dev/null || true; docker compose version 2>/dev/null || true; compose ps 2>/dev/null || true; du -sh synapse/media_store postgres/data redis/data 2>/dev/null || true; free -h 2>/dev/null || true; df -h .; }
backup(){ load_env; local ts tmp out; ts=$(date +%F_%H-%M); tmp="backups/tmp/$ts"; out="backups/$ts.tar.zst"; mkdir -p "$tmp"; compose exec -T postgres pg_dump -U "$POSTGRES_USER" "$POSTGRES_DB" > "$tmp/postgres.sql"; compose exec -T redis redis-cli -a "$REDIS_PASSWORD" --rdb /data/dump.rdb >/dev/null || true; cp -a .env compose.yaml synapse coturn element nginx redis/data "$tmp/" 2>/dev/null || true; tar -C "$tmp" -cf - . | zstd -T0 -19 -o "$out"; rm -rf "$tmp"; log_info "Backup: $out"; }
restore(){ need_root; local a=${1:-}; [[ -f $a ]] || die "Usage: $0 restore backups/file.tar.zst"; compose down || true; rm -rf backups/tmp/restore; mkdir -p backups/tmp/restore; zstd -dc "$a" | tar -C backups/tmp/restore -xf -; cp -a backups/tmp/restore/. .; compose up -d; }
package(){ local out="laziestmatrix-${VERSION}.tar.zst"; tar --exclude='./.git' --exclude='./.env' --exclude='./postgres/data' --exclude='./redis/data' --exclude='./synapse/media_store' --exclude='./synapse/uploads' --exclude='./certs' --exclude='./backups' --exclude='./logs' -cf - . | zstd -T0 -19 -o "$out"; log_info "Package: $out"; }
case "${1:-}" in install) install;; deploy|start) load_env; render; compose up -d;; update|upgrade) load_env; compose pull; compose build --pull; compose up -d; docker image prune -f;; backup) backup;; restore) restore "${2:-}";; doctor) doctor;; status) status;; logs) shift; compose logs -f "${@:-}";; restart) compose restart;; stop) compose stop;; users) users;; cert) cert;; package) package;; version) echo "$VERSION";; uninstall) need_root; compose down -v; log_warn "Data directories remain unless removed manually.";; *) echo "Usage: sudo ./laziestmatrix {install|deploy|update|upgrade|backup|restore|doctor|status|logs|restart|stop|start|users|cert|package|version|uninstall}"; exit 1;; esac
